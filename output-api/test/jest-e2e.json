{
  "rootDir": "..",
  "testEnvironment": "node",
  "moduleFileExtensions": ["ts", "js", "json", "cjs"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "setupFiles": ["<rootDir>/test/setup-env.cjs"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
  },
  "testTimeout": 15000
}
