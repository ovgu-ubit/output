{
   "compilerOptions": {
      "lib": [
         "ES2023",
         "DOM"
      ],
      "target": "ES2023",
      "module": "NodeNext",
      "moduleResolution": "nodenext",
      "outDir": "./dist",
      "rootDir": "./",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "incremental": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "strict": false,
      "types": ["node", "multer"]
   },
   "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
